-- UNC Helper Functions
local function safeFirePrompt(prompt: ProximityPrompt?, holdTime: number?): boolean
    if not prompt or not prompt:IsA("ProximityPrompt") or not prompt.Parent then return false end
    local duration = holdTime or 0
    
    pcall(function()
        prompt.HoldDuration = duration
    end)

    if typeof(fireproximityprompt) == "function" then
        pcall(function() fireproximityprompt(prompt, duration) end)
    else
        pcall(function()
            prompt:InputHoldBegin()
            task.wait(0.05)
            prompt:InputHoldEnd()
        end)
    end
    return true
end

local function getCharacterRoot(): (Model?, BasePart?)
    local character = LocalPlayer.Character
    if not character then return nil, nil end
    local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
    return character, root
end

