                                pcall(function()
                                    fireproximityprompt(prompt, 0)
                                end)
                            else
                                pcall(function()
                                    prompt:InputHoldBegin()
                                    task.wait(0.05)
                                    prompt:InputHoldEnd()
                                end)
                            end

                            -- Immediately fire RemoteServer 3×
                            for _ = 1, 3 do
                                pcall(function()
                                    Reliable:FireServer(
                                        "Section3/CircuitRoundComplete",
                                        targetPillar
                                    )
                                end)
                                task.wait(0.05)
                            end

                            print("[Circuits] Completed " .. index .. "/6: " .. targetPillar.Name)
                        else
                            warn("[Circuits] Prompt not found: " .. targetPillar.Name)
                        end
                    end

                    task.wait(0.15)
                end

                -- Post-generator sequence
                character = plr.Character
                hrp = character and character:FindFirstChild("HumanoidRootPart")

                if character and hrp then
                    hrp.AssemblyLinearVelocity = Vector3.zero
                    hrp.AssemblyAngularVelocity = Vector3.zero

                    local postTpCF = CFrame.new(
                        -3392.06787, 40.829792, 762.187195,
                        0.999989152, 0, 0.00466137705,
                        0, 1, 0,
                        -0.00466137705, 0, 0.999989152
                    )

                    local firstTweenCF = CFrame.new(
                        -3391.67725, 18.2818604, 787.921143
                    )

                    local secondTweenCF = CFrame.new(
                        -3391, 8, 753
                    )

                    local finalTweenCF = CFrame.new(
                        -3390.76367, 12.6986799, 894.754578
                    )

                    character:PivotTo(postTpCF)
                    task.wait(0.3)

                    local dist1 = (firstTweenCF.Position - postTpCF.Position).Magnitude
                    local tween1 = TweenService:Create(
                        hrp,
                        TweenInfo.new(dist1 / 250, Enum.EasingStyle.Linear),
                        {CFrame = firstTweenCF}
                    )
                    tween1:Play()
                    tween1.Completed:Wait()

                    task.wait(25)

                    character = plr.Character
                    hrp = character and character:FindFirstChild("HumanoidRootPart")

                    if character and hrp then
                        local dist2 = (secondTweenCF.Position - firstTweenCF.Position).Magnitude
                        local tween2 = TweenService:Create(
                            hrp,
                            TweenInfo.new(dist2 / 250, Enum.EasingStyle.Linear),
                            {CFrame = secondTweenCF}
                        )
                        tween2:Play()
                        tween2.Completed:Wait()
                    end

                    task.wait(0.5)

                    character = plr.Character
                    hrp = character and character:FindFirstChild("HumanoidRootPart")

                    if character and hrp then
                        local dist3 = (finalTweenCF.Position - secondTweenCF.Position).Magnitude
                        local tween3 = TweenService:Create(
                            hrp,
                            TweenInfo.new(dist3 / 250, Enum.EasingStyle.Linear),
                            {CFrame = finalTweenCF}
                        )
                        tween3:Play()
                        tween3.Completed:Wait()
                    end
                end

                if noclipConnection then
                    noclipConnection:Disconnect()
                end

                print("[Circuits] Auto Complete finished!")
            end)
        end
    })
end, "Auto Complete Circuits Button")

