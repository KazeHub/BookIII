WaterTab:Button({
    Title = "Auto WireBoxes",
    Callback = function()
        task.spawn(function()
            local character, myRoot = getCharacterRoot()
            if not character or not myRoot then return end

            local section5 = Workspace:FindFirstChild("Section5")
            local mainObjective = section5 and section5:FindFirstChild("MainObjective")
            local boxesFolder = mainObjective and mainObjective:FindFirstChild("Boxes")

            if not boxesFolder then return end

            local Reliable = getReliableRemote()
            if not Reliable then return end

            local camera = Workspace.CurrentCamera
            local wireBoxes = {}

            for _, child in ipairs(boxesFolder:GetChildren()) do
                if child.Name == "WireBox" then
                    table.insert(wireBoxes, child)
                end
            end

            for _, wireBox in ipairs(wireBoxes) do
                character, myRoot = getCharacterRoot()
                if not character or not myRoot then break end

                if camera then
                    camera.CameraType = Enum.CameraType.Custom
                    local humanoid = character:FindFirstChildOfClass("Humanoid")
                    if humanoid then camera.CameraSubject = humanoid end
                end

                myRoot.Anchored = false
                myRoot.AssemblyLinearVelocity = Vector3.zero
                myRoot.AssemblyAngularVelocity = Vector3.zero

                if wireBox:IsA("BasePart") then
                    character:PivotTo(wireBox.CFrame + Vector3.new(0, 0, 4))
                elseif wireBox:IsA("Model") then
                    character:PivotTo(wireBox:GetPivot() + Vector3.new(0, 0, 4))
                end

                task.wait(0.15)

                pcall(function()
                    Reliable:FireServer("Section5/WireBoxClaim", wireBox)
                end)
                task.wait(0.05)

                local lid = wireBox:FindFirstChild("Lid")
                if lid then
                    pcall(function()
                        Reliable:FireServer("Section5/WireBoxLidOpen", lid)
                    end)
                end
                task.wait(0.1)

                local prompt: ProximityPrompt? = wireBox:FindFirstChildWhichIsA("ProximityPrompt", true)
                if prompt then
                    safeFirePrompt(prompt)
                end
                task.wait(0.1)

                local cuttable = wireBox:FindFirstChild("Cuttable")
                if cuttable then
                    for _, cutItem in ipairs(cuttable:GetChildren()) do
                        pcall(function()
                            Reliable:FireServer("Section5/WireBoxCutDone", cutItem)
                        end)
                        task.wait(0.03)
                    end
                end

                pcall(function()
                    Reliable:FireServer("Section5/WireBoxComplete", wireBox)
                end)
                task.wait(0.15)
            end

            if camera then
                camera.CameraType = Enum.CameraType.Custom
                if character then
                    local humanoid = character:FindFirstChildOfClass("Humanoid")
                    if humanoid then camera.CameraSubject = humanoid end
                end
            end
        end)
    end
})
