})

IJO:Button({
    Title = "Auto Shape Terminal",
    Callback = function()
        local modules = ReplicatedStorage:WaitForChild("modules")
        local packet = modules:WaitForChild("Packet")
        local PacketModule = require(packet) :: any

        local function getTerminals()
            local s4 = Workspace:FindFirstChild("Section4")
            local lab = s4 and s4:FindFirstChild("Lab")
            local clean = lab and lab:FindFirstChild("CleanseRoomObjective")
            local folder = clean and clean:FindFirstChild("ShapeTerminals")

            if not folder then return {} end

            local terminals = {}
            for _, v in ipairs(folder:GetChildren()) do
                if (v:IsA("Model") or v:IsA("BasePart")) and v.Name ~= "ControlSystemOnline" then
                    table.insert(terminals, v)
                end
            end

            table.sort(terminals, function(a, b)
                return (tonumber(a.Name:match("%d+")) or 0) < (tonumber(b.Name:match("%d+")) or 0)
            end)

            return terminals
        end

        local function run()
            local terminals = getTerminals()
            if #terminals == 0 then return false end

            local character, myRoot = getCharacterRoot()
            if not character or not myRoot then return false end

            for _, term in ipairs(terminals) do
                if not term.Parent then continue end

                character, myRoot = getCharacterRoot()
                if not character or not myRoot then return false end

                local targetCF = term:IsA("Model") and (term:GetPivot() * CFrame.new(0, 1, 3)) or (term.CFrame * CFrame.new(0, 1, 3))
                character:PivotTo(targetCF)
                task.wait(0.08)

                local prompt: ProximityPrompt? = term:FindFirstChildWhichIsA("ProximityPrompt", true)
                if prompt then
                    safeFirePrompt(prompt, 0)
                end

                pcall(function()
                    PacketModule.send.ShapeTerminal.RoundComplete(term)
                    PacketModule.send.ShapeTerminal.RoundComplete(term)
                end)

                task.wait(0.08)
            end

            for _, term in ipairs(terminals) do
                pcall(function()
                    PacketModule.send.ShapeTerminal.Release(term)
                end)
            end

            return true
        end

        task.spawn(function()
            run()
            task.wait(0.3)
            run()
        end)
    end
})

IJO:Button({
