            local exitToStairs = lab and lab:FindFirstChild("ExitToStairs")
            local exitObj = exitToStairs and exitToStairs:FindFirstChild("EXIT")

            if exitObj then
                local character, myRoot = getCharacterRoot()
                local targetPart = exitObj:IsA("BasePart") and exitObj or exitObj:FindFirstChildWhichIsA("BasePart", true) or exitObj:GetPrimaryPart()
                
                if character and myRoot and targetPart then
                    myRoot.AssemblyLinearVelocity = Vector3.zero
                    myRoot.AssemblyAngularVelocity = Vector3.zero
                    character:PivotTo(targetPart.CFrame + Vector3.new(0, 2, 2))
                end

                task.wait(0.2)

                local prompt: ProximityPrompt? = exitObj:FindFirstChildOfClass("ProximityPrompt") or exitObj:FindFirstChildWhichIsA("ProximityPrompt", true)
                if prompt then
                    local enableStart = tick()
                    while (not prompt.Parent or not prompt.Enabled) and (tick() - enableStart < 5) do
                        task.wait(0.05)
                    end

                    prompt.RequiresLineOfSight = false
                    prompt.MaxActivationDistance = 10
                    prompt.Enabled = true

                    task.wait(0.016)
                    safeFirePrompt(prompt, 0)
                end
            end
        end)
    end
})

